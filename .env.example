# Copy to .env and fill in your values.

# TrueFoundry AI Gateway (SaaS)
TFY_GATEWAY_URL=https://gateway.truefoundry.ai
TFY_API_KEY=your_truefoundry_pat_here

# Traceloop / TrueFoundry observability
TFY_TRACING_ENDPOINT=https://gateway.truefoundry.ai/api/tracing
TFY_TRACING_PROJECT=compress-logs-demo

# Model routing — set these to Virtual Model names once configured in TFY:
#   e.g. "openai/logdiag/triage" and "openai/logdiag/analysis"
TRIAGE_MODEL=openai/openai-main/gpt-4o-mini
ANALYSIS_MODEL=openai/openai-main/gpt-4o
